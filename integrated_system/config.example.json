{
  "llm": {
    "provider": "deepseek",
    "api_key": "YOUR_API_KEY_HERE",
    "base_url": "https://api.deepseek.com/v1",
    "model": "deepseek-chat",
    "max_tokens": 512,
    "temperature": 0.7
  },
  "voice": {
    "mic": "plughw:1,0",
    "speaker": "plughw:0,0",
    "gain_db": 10,
    "vad_aggressiveness": 2,
    "silence_duration": 1.0,
    "wakeup_enabled": true,
    "wakeup_keywords": ["小狗"],
    "tts_backend": "auto",
    "tts_volume_db": "-5"
  },
  "motion": {
    "arbiter_ip": "127.0.0.1",
    "arbiter_port": 5005,
    "move_duration_sec": 2.5,
    "discrete_wait_sec": 2.0
  },
  "asr": {
    "vosk_model_path": "/app/puppy_ws/models/vosk-model-small-cn-0.22"
  },
  "vision": {
    "enabled": true,
    "provider": "siliconflow",
    "api_key": "YOUR_SILICONFLOW_KEY_HERE",
    "base_url": "https://api.siliconflow.cn/v1",
    "model": "Pro/moonshotai/Kimi-K2.6",
    "max_tokens": 256,
    "snapshot_url": "http://127.0.0.1:8094/snapshot",
    "timeout_sec": 30
  }
}
